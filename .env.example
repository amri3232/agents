POLYGON_WALLET_PRIVATE_KEY=""
OPENAI_API_KEY=""
# Research sources for the forecaster. Both are optional, but WITHOUT AT LEAST
# ONE the agent forecasts blind: it sees only the market description, so it
# cannot know anything the market does not already know, and has no basis for
# an edge. The prompt is told when it is blind and instructed to stay near the
# market price; the journal records which sources answered so
# `cli.py journal-report` can split calibration by it.
TAVILY_API_KEY=""
NEWSAPI_API_KEY=""

# --- Safety ---------------------------------------------------------------
# Live trading is opt-in. While true (the default), a run forecasts, scores,
# prices and journals the order, and sends nothing. Read PRE-FLIGHT-AUDIT.md
# before setting this to false.
POLYMARKET_DRY_RUN="true"
# Hard ceiling on a single order, in USDC.
POLYMARKET_MAX_ORDER_USDC="5"
# Ceiling on live notional per UTC day, counted from the journal.
POLYMARKET_MAX_DAILY_USDC="20"

# --- Strategy -------------------------------------------------------------
# Minimum probability edge over the live ask before a trade is taken. The
# spread and the agent's own forecast error both eat into this.
POLYMARKET_MIN_EDGE="0.10"
# Fraction of full Kelly to stake. Full Kelly assumes the probability is
# correct; it is not, so stay well below it.
POLYMARKET_KELLY_FRACTION="0.25"
# Hard cap on the bankroll fraction in one position, whatever Kelly says.
POLYMARKET_MAX_BANKROLL_FRACTION="0.05"
# Markets to forecast per run. Each one costs an LLM call.
POLYMARKET_MAX_CANDIDATES="5"
# Where decisions are recorded, for measuring calibration later.
POLYMARKET_JOURNAL="trade_journal.jsonl"

# --- Proxy wallet ---------------------------------------------------------
# Leave both empty to trade from the EOA that owns the private key above.
# If you deposited through polymarket.com your USDC is in a proxy wallet
# instead, and the agent will read a zero balance without these.
# 1 = email/magic proxy, 2 = browser-wallet proxy.
POLYMARKET_SIGNATURE_TYPE=""
# The proxy wallet address holding the USDC.
POLYMARKET_FUNDER=""
