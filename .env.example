POLYGON_WALLET_PRIVATE_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
NEWSAPI_API_KEY=""

# Live trading is opt-in. While true (the default), a run prices and validates
# the order, prints it, and sends nothing. Read PRE-FLIGHT-AUDIT.md before
# setting this to false.
POLYMARKET_DRY_RUN="true"
# Hard ceiling on a single order, in USDC, applied after the model's
# size_fraction is taken off the balance.
POLYMARKET_MAX_ORDER_USDC="5"
