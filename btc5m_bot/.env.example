# ============================================================================
#  Vorlage: kopieren mit   cp .env.example .env   und Werte eintragen.
#  Die Datei .env enthält Geheimnisse: NIE committen, teilen oder in Screenshots zeigen.
#  Für den PAPER-Modus (Standard, kein echtes Geld) wird NICHTS davon benötigt.
# ============================================================================

# Private Key der Wallet, die Orders signiert (0x...). Empfehlung: eigene Bot-Wallet
# mit nur dem Betrag, den du bereit bist zu riskieren.
PRIVATE_KEY=

# Polymarket-CLOB-API-Zugang (optional: bleibt er leer, leitet der Bot ihn aus PRIVATE_KEY ab).
POLYMARKET_API_KEY=
API_SECRET=
PASSPHRASE=

# Polygon-RPC (HTTPS-URL, z. B. von Alchemy/Infura/QuickNode oder https://polygon-rpc.com).
# Wird für das automatische Einlösen (Redeem) und Gas-/Guthaben-Checks benötigt.
RPC_URL=

# Wallet-Typ:  0 = normale Wallet (EOA, Standard)
#              1 = Polymarket-Konto per E-Mail/Magic-Login (Proxy)
#              2 = Polymarket-Konto per Browser-Wallet (Gnosis-Safe)
# Bei 1 oder 2 muss FUNDER_ADDRESS die Adresse deines Polymarket-Profils sein (dort liegt das Geld).
SIGNATURE_TYPE=0
FUNDER_ADDRESS=

# Optional: beliebige Parameter aus config.py lassen sich hier überschreiben, Schema BOT_<NAME>, z. B.
# BOT_MODE=PAPER
# BOT_MAX_POSITION_USD=5
